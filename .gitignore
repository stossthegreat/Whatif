.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# NOTE: android/app/upload-keystore.jks is deliberately NOT ignored — the
# upload key lives in the repo, the same way the other Rivler app repos do it,
# so a release build needs no dashboard configuration and no CI secrets
# anywhere. Keep this repo's collaborator list tight, because anyone who can
# read it can sign builds as Rivler.

# Machine-local SDK paths, written by the Flutter tool and by CI
/android/local.properties
