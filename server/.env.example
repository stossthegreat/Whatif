# Copy to .env for local dev. On Railway, set these as service variables.

# Railway provides PORT automatically; default for local dev:
PORT=8080

# LiveKit (the live group-video layer). Get these from a free LiveKit Cloud
# project (https://cloud.livekit.io) or a self-hosted LiveKit server.
# If left empty, matchmaking still works but video is disabled (fail-soft).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# When true, a lone user is dropped into a solo cell after a short wait so a
# single tester can experience the flow. Turn OFF once you have real traffic —
# Rivlr never fabricates fake humans.
ALLOW_SOLO=true
SOLO_WAIT_MS=6000

# Baseline added to the live-count so an early, low-traffic app still reads as
# alive. Set to 0 for the true number.
LIVE_BASELINE=0
